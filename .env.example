# Copy this file to .env (local dev) or paste the values into the
# Vercel dashboard under Project Settings -> Environment Variables.

# ---------------------------------------------------------------------------
# Meta webhook verification
# Pick a random string; Meta will send it back as hub.verify_token when you
# register the webhook, and the app compares it to this value.
# Generate one with: openssl rand -hex 32
# ---------------------------------------------------------------------------
META_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Meta App Secret (optional but recommended)
# Found at developers.facebook.com -> your app -> Settings -> Basic.
# When set, every incoming webhook POST is verified with X-Hub-Signature-256.
# ---------------------------------------------------------------------------
META_APP_SECRET=

# ---------------------------------------------------------------------------
# Page Access Token
# Generated in the Messenger product settings for your Facebook Page.
# The same token is used to send Instagram DMs / replies for the IG account
# linked to that Page, and to reply to Facebook Page comments/messages.
# ---------------------------------------------------------------------------
META_PAGE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Instagram Business/Creator account ID (optional, informational)
# Shown on the dashboard; the actual sending uses META_PAGE_ACCESS_TOKEN.
# ---------------------------------------------------------------------------
META_IG_USER_ID=

# ---------------------------------------------------------------------------
# Database (optional)
# When set, triggers and events are stored in Postgres.
# Example (Neon / Supabase / any Postgres):
#   DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# When unset, the app falls back to local JSON files in ./data/ (dev only —
# the JSON fallback does NOT persist on Vercel serverless).
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Meta App ID (optional in v1, required for v2 OAuth "Connect Instagram")
# Found at developers.facebook.com -> your app -> Settings -> Basic.
# ---------------------------------------------------------------------------
META_APP_ID=

# ---------------------------------------------------------------------------
# Dashboard access password (optional hardening)
# When set, every dashboard page and server action requires this password.
# The webhook (/api/webhook) and the legal pages (/privacy, /terms) stay open.
# Plain English words are fine — it does NOT need to be a hash.
# To accept more than one password, separate them with commas:
#   DASHBOARD_PASSWORD=BlueTigerRunsFast2026, XzQWBZbdn4WtZpp1sjHXQr3
# (no commas inside a single password)
# ---------------------------------------------------------------------------
DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# Encryption key for stored Page tokens (v2, lib/crypto.ts)
# AES-256-GCM -> 32 bytes as a 64-char hex string. Generate with:
#   openssl rand -hex 32
# NEVER commit the real value; set it in Vercel too when token storage ships.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Auth.js (next-auth v2 account sign-in: /signup + /login email form)
# Signs JWT session cookies. Generate with: openssl rand -base64 32
# When unset, the email/password forms will not issue sessions (the legacy
# DASHBOARD_PASSWORD gate keeps working either way).
# ---------------------------------------------------------------------------
AUTH_SECRET=
